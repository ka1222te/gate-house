# 値はシングルクォートで囲んでください ($ や ` を含む値でも安全)
# ===== Cloudflare 設定 =====
# API トークン (My Profile > API Tokens > Create Custom Token) に必要な権限:
#   Account / Workers Scripts : Edit
CF_API_TOKEN=''
CF_ACCOUNT_ID=''
WORKER_NAME='gate-house'           # => https://gate-house.<subdomain>.workers.dev

# ===== Google ログイン (OAuth 2.0) =====
# Google Cloud Console > Google Auth Platform > クライアント で「ウェブ アプリケーション」を作成
#   承認済みのリダイレクト URI: https://<WORKER_NAME>.<subdomain>.workers.dev/__auth/callback
#   (./scripts/setup.sh の最後に表示されます)
GOOGLE_CLIENT_ID=''                # 例: 1234567890-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=''
GOOGLE_HD=''                       # 任意: Google Workspace のドメインに限定 (例: example.ac.jp)

# ===== 許可リスト =====
# 次の 2 つを合わせたアドレスがログインできます (どちらか一方だけでも可)
#   ALLOWED_EMAILS      : カンマまたは空白区切り。@example.ac.jp でドメイン全体を許可。変更は再起動で反映
#   ALLOWED_EMAILS_FILE : 1 行 1 件のファイル (相対パスはこのディレクトリ基準)。保存すると即時反映
ALLOWED_EMAILS=''                  # 例: 'taro@gmail.com, @example.ac.jp'
ALLOWED_EMAILS_FILE='allowed_emails.txt'

# ===== ログイン =====
APP_NAME='Web アプリ'              # ログイン画面に表示する名前
SESSION_HOURS='24'                 # ログイン状態の有効時間
PUBLIC_URL=''                      # 任意: 公開 URL (空なら workers.dev の URL)
COOKIE_NAME='gate-house'           # Cookie 名 (__Host-<COOKIE_NAME>_session)。変えると全員ログアウト

# ===== ローカル =====
ORIGIN_URL=''                      # 公開する内部の Web アプリ (例: http://app.internal.example)
GATE_PORT='18787'                  # ゲートキーパー(127.0.0.1) の待受ポート
